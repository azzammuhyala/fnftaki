# install: `pip install moviepy`
import moviepy

inst = moviepy.AudioFileClip('assets/songs/markov/Inst.ogg')
voices = moviepy.AudioFileClip('assets/songs/markov/Voices.ogg')

moviepy.CompositeAudioClip([
    inst.with_start(0),
    voices.with_start(0)
]).write_audiofile('music.ogg')

inst.close()
voices.close()