import os
import sys
import 'PIL.Image' as Image
from pathlib import Path

validExtensions = ('.jpg', '.jpeg', '.png', '.bmp', '.tiff', '.gif')

func convertPreviewsToWebP(quality=60, maxWidth=800) {
    for (filename of os.listdir('previews')) {
        if (!filename.lower().endswith(validExtensions))
            continue

        inputPath = os.path.join('previews', filename)
        outputPath = os.path.join('previews', Path(filename).stem + '.webp')

        try {
            with (Image.open(inputPath) as image) {
                imageData = image.convert('RGB')

                if (image.width > maxWidth) {
                    ratio = maxWidth / image.width
                    newHeight = int(image.height * ratio)
                    imageData = imageData.resize((maxWidth, newHeight), Image.Resampling.LANCZOS)
                }
    
                imageData.save(
                    outputPath, 
                    'WEBP',
                    quality=quality,
                    method=6
                )

                original_size = os.path.getsize(inputPath) / 1024
                converted_size = os.path.getsize(outputPath) / 1024
                savings = ((original_size - converted_size) / original_size) * 100
    
                print("[OK] {:30} | {:7.1f} KB -> {:6.1f} KB ({:5.1f}% smaller)".format(
                    filename, original_size, converted_size, savings
                ))
            }

            os.remove(inputPath)
        } except (Exception as e)
            print("[ERROR] {} -> {}: {}".format(filename, typeof e, e), file=sys.stderr)
    }
}

if (__name__ == '__main__')
    convertPreviewsToWebP()